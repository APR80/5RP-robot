<!--
This is used in linear controller algorithm from Craig’s Introduction to Robotics.
The derivation assumes the joints are highly geared (so each joint behaves like a linear second-order system)
and that gravity is compensated for — I handle that by using the attribute and turning gravity off in the XML file.
-->
<mujoco>
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option gravity="0 0 0"  integrator="implicitfast"/>
  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
  <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
  <rgba haze="0.15 0.25 0.35 1"/>
  <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
  <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
  <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
  <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <default class="5RP">
      <material specular="0.5" shininess="0.25"/>
      <joint range="-3.1415 3.1415"  axis="0 0 1" armature="5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
    </default>
  </default>

  <asset>
    <material class="5RP" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="5RP" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="5RP" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="5RP" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
    <mesh name="motor" file="motor.STL" scale="0.01 0.01 0.01"/>
    <mesh name="shaft" file="shaft.stl" scale="0.01 0.01 0.01"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="base"  childclass="5RP">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom mesh="base_0" material="black" class="visual"/>
      <geom mesh="base_1" material="jointgray" class="visual"/>

      <body name="shoulder_link" pos="0 0 0.163">
        <inertial mass="3.7" pos="0 0 0" diaginertia="0.0102675 0.0102675 0.00666"/>
        <joint name="shoulder_pan_joint"/>
        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>

          <body name="upper_arm_link" pos="0 0.138 0" quat="1 -1 0 0">
            <inertial mass="8.393" pos="0.2125 0 0" diaginertia="0.0151074 0.133886 0.133886"/>
            <joint name="shoulder_lift_joint"/>
            <geom mesh="upperarm_0" material="linkgray" class="visual" quat="0.5 0.5 0.5 0.5"/>
            <geom mesh="upperarm_1" material="black" class="visual" quat="0.5 0.5 0.5 0.5"/>
            <geom mesh="upperarm_2" material="jointgray" class="visual" quat="0.5 0.5 0.5 0.5"/>
            <geom mesh="upperarm_3" material="urblue" class="visual" quat="0.5 0.5 0.5 0.5"/>

              <body name="forearm_link" pos="0.425 0 -0.131">
                <inertial mass="2.275" pos="0.196 0 0" diaginertia="0.004095 0.0311796 0.0311796"/>
                <joint name="elbow_joint"/>
                <geom mesh="forearm_0" material="urblue" class="visual" quat="0.5 0.5 0.5 0.5" />
                <geom mesh="forearm_1" material="linkgray" class="visual" quat="0.5 0.5 0.5 0.5"/>
                <geom mesh="forearm_2" material="black" class="visual" quat="0.5 0.5 0.5 0.5"/>
                <geom mesh="forearm_3" material="jointgray" class="visual" quat="0.5 0.5 0.5 0.5"/>

                  <body name="wrist_1_link" pos="0.392 0 0.127">
                    <inertial mass="1.219" pos="0 0 0" diaginertia="0.0025599 0.0021942 0.0025599"/>
                    <joint name="wrist_2_joint"/>
                    <geom mesh="wrist1_0" material="black" class="visual" pos="0 0 -0.127" quat="0 0 0.70710678 0.70710678"/>
                    <geom mesh="wrist1_1" material="urblue" class="visual" pos="0 0 -0.127" quat="0 0 0.70710678 0.70710678"/>
                    <geom mesh="wrist1_2" material="jointgray" class="visual" pos="0 0 -0.127" quat="0 0 0.70710678 0.70710678"/>

                      <body name="wrist_2_link" pos="0 0.1 0" quat="0.70710678 -0.70710678 0 0">
                        <inertial mass="1.8779" pos="0 -0.1113 0" diaginertia="0.00594027 0.00360899 0.00539952"/>
                        <geom mesh="wrist2_0" material="black" class="visual" pos="0 0 -0.1" quat="0 0 0 1"/>
                        <geom mesh="wrist2_1" material="urblue" class="visual" pos="0 0 -0.1" quat="0 0 0 1"/>
                        <geom mesh="wrist2_2" material="jointgray" class="visual" pos="0 0 -0.1" quat="0 0 0 1"/>
                        <joint name="link_5"/>
                        <geom material="linkgray" mesh="wrist3" class="visual" quat="0 0 0 1"/>
                        <geom type="mesh"  mesh="motor" pos="0 -0.1 0" quat="0 0 0.70710678 -0.70710678"/>

                         <body name="shaft" pos="0 -0.205 0" quat="0.70710678 0.70710678 0 0">
                            <inertial mass="0.089743" pos="0 0 -0.04" diaginertia="0.000194 0.000194 0.000006"/>
                            <geom type="mesh" name="shaft" mesh="shaft" rgba="0.4 0.4 0.4 1" />
                            <joint name="prismatic"  type="slide" range="0 0.075" armature="1"/>
                            <site name="attachment_site" size="0.01" quat="0 0 0 1" rgba="1 0 0 1" group="1"/>
                         </body>
                      </body>
                  </body>
            </body>
          </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor  name="shoulder_pan" joint="shoulder_pan_joint" forcerange="-150 150"/>
    <motor  name="shoulder_lift" joint="shoulder_lift_joint" forcerange="-150 150"/>
    <motor  name="elbow" joint="elbow_joint" forcerange="-150 150"/>
    <motor  name="wrist_1" joint="wrist_2_joint" forcerange="-150 150"/>
    <motor  name="wrist_2" joint="link_5" forcerange="-150 150"/>
    <motor  name="linear" joint="prismatic" forcerange="-150 150"/>
  </actuator>

  <sensor>
    <framepos name="eepos" objtype="site" objname="attachment_site"/>
    <framequat name="eeatt" objtype="site" objname="attachment_site"/>
    <framelinvel name="linvel" objtype="site" objname="attachment_site"/>
    <frameangvel name="angvel" objtype="site" objname="attachment_site"/>
    <frameangacc name="angacc" objtype="site" objname="attachment_site"/>
    <framelinacc name="linacc" objtype="site" objname="attachment_site"/>
  </sensor>

</mujoco>
